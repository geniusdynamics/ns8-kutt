#
# Generate the secrets once, in files readable by the module only:
# - passwords.env: DB_PASSWORD and JWT_SECRET for Kutt (configure-module
#   adds OIDC_CLIENT_SECRET when it is set)
# - postgres.env: the PostgreSQL user, database and the same password
# Secrets never go to the module environment: agent.set_env() stores it in
# Redis, readable by every module.
#

import os
import secrets

state = os.environ["AGENT_STATE_DIR"]
db_password = secrets.token_urlsafe(24)


def write_new(name, values):
    path = os.path.join(state, name)
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        return  # never replace existing secrets
    with os.fdopen(fd, "w") as fp:
        for key, value in values.items():
            fp.write(f"{key}={value}\n")


write_new("passwords.env", {
    "DB_PASSWORD": db_password,
    "JWT_SECRET": secrets.token_urlsafe(48),
})
write_new("postgres.env", {
    "POSTGRES_USER": "kutt",
    "POSTGRES_DB": "kutt",
    "POSTGRES_PASSWORD": db_password,
})
