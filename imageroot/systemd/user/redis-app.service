#
# Redis caches links and visits for Kutt. It keeps nothing worth saving:
# persistence is off and there is no volume.
#
[Unit]
Description=Podman redis-app.service
BindsTo=kutt.service
After=kutt.service
Before=kutt-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
Restart=always
RestartSec=10
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/redis-app.pid %t/redis-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/redis-app.pid \
    --cidfile %t/redis-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/kutt.pod-id --replace -d --name redis-app \
    ${REDIS_IMAGE} \
    redis-server --bind 127.0.0.1 --save "" --appendonly no
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/redis-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/redis-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/redis-app.pid
Type=forking

[Install]
WantedBy=default.target
