# Before a backup: dump the Kutt database in the PostgreSQL custom format,
# restored by restore-module/40restore_database.

set -e -o pipefail

if ! systemctl --user -q is-active kutt.service; then
    exit 0
fi
echo "Dumping the kutt database" 1>&2
podman exec postgresql-app pg_dump -U kutt --format=c kutt > kutt.pg_dump
