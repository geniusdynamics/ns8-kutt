#
# Write smarthost.env with the MAIL_* settings Kutt reads, from the cluster
# smarthost. Without a smarthost Kutt runs with e-mail off: no password
# reset, e-mail verification or reports. Runs before kutt-app starts.
#

import os

import agent

# The local Redis replica answers even if the leader node is unreachable
rdb = agent.redis_connect(use_replica=True)
smtp = agent.get_smarthost_settings(rdb)

host = os.environ.get("TRAEFIK_HOST", "localhost")
site_name = os.environ.get("KUTT_SITE_NAME") or "Kutt"
mail_from = os.environ.get("KUTT_MAIL_FROM") or f"{site_name} <noreply@{host}>"

if smtp.get("enabled") and smtp.get("host"):
    mail = {
        "MAIL_ENABLED": "true",
        "MAIL_HOST": smtp["host"],
        "MAIL_PORT": str(smtp["port"]),
        # "tls" is TLS from the first byte; with STARTTLS nodemailer upgrades
        # the plain connection by itself
        "MAIL_SECURE": "true" if smtp.get("encrypt_smtp") == "tls" else "false",
        "MAIL_FROM": mail_from,
    }
    if smtp.get("username"):
        mail["MAIL_USER"] = smtp["username"]
        mail["MAIL_PASSWORD"] = smtp.get("password", "")
else:
    mail = {"MAIL_ENABLED": "false"}

# Owner only: the file holds the smarthost password. Replace the old file
# only once the new one is complete.
tmp = "smarthost.env.tmp"
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as fp:
    for key, value in mail.items():
        fp.write(f"{key}={value}\n")
os.replace(tmp, "smarthost.env")
