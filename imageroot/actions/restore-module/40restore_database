#
# Load the kutt.pg_dump of the backup into a new postgres-data volume: a
# temporary PostgreSQL creates the database (postgres.env), runs the script
# below from its init directory with the dump on stdin, then stops.
#

set -e -o pipefail
exec 1>&2

if [[ ! -f kutt.pg_dump ]]; then
    echo "No kutt.pg_dump in the backup: Kutt starts with an empty database"
    exit 0
fi

mkdir -vp restore
cat - >restore/kutt_restore.sh <<'EOS'
pg_restore --no-owner --no-privileges -U kutt -d kutt
ec=$?
docker_temp_server_stop
exit $ec
EOS
trap 'rm -rfv restore/ kutt.pg_dump' EXIT

podman run \
    --rm \
    --interactive \
    --network=none \
    --volume=./restore:/docker-entrypoint-initdb.d/:Z \
    --volume=postgres-data:/var/lib/postgresql:Z \
    --env-file=postgres.env \
    --env TZ=UTC \
    --replace --name=restore_db \
    "${POSTGRES_IMAGE}" < kutt.pg_dump
