#
# PostgreSQL 18 keeps its data under /var/lib/postgresql/18/docker: the
# volume is mounted on /var/lib/postgresql. postgres.env (mode 0600) holds
# POSTGRES_USER, POSTGRES_DB and POSTGRES_PASSWORD.
#
[Unit]
Description=Podman postgresql-app.service
BindsTo=kutt.service
After=kutt.service
Before=kutt-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%S/state/environment
Restart=always
RestartSec=10
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/postgresql-app.pid %t/postgresql-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/postgresql-app.pid \
    --cidfile %t/postgresql-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/kutt.pod-id --replace -d --name postgresql-app \
    --env-file=%S/state/postgres.env \
    --env TZ=UTC \
    --volume postgres-data:/var/lib/postgresql:Z \
    ${POSTGRES_IMAGE}
ExecStartPost=/usr/bin/bash -c "while ! podman exec postgresql-app pg_isready -h 127.0.0.1 -U kutt -d kutt; do sleep 3; done"
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/postgresql-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/postgresql-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/postgresql-app.pid
Type=forking

[Install]
WantedBy=default.target
