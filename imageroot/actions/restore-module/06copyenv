# Copy the route and the Kutt settings (KUTT_*) from the backed-up
# environment. Secrets come back with passwords.env and postgres.env.

import json
import sys

import agent

renv = json.load(sys.stdin)["environment"]
for name, value in renv.items():
    if name in ("TRAEFIK_HOST", "TRAEFIK_HTTP2HTTPS") or name.startswith("KUTT_"):
        agent.set_env(name, value)
